# ============================================
# DATABASE
# ============================================

# PostgreSQL connection string
# Example:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/mentoring_db?schema=public"


# ============================================
# PAYMENT PROVIDER
# ============================================

# Credentials used to communicate with the payment provider.
# The final variable names may change once the provider is selected.
PAYMENT_API_KEY=

# Secret used to validate incoming payment webhooks.
PAYMENT_WEBHOOK_SECRET=


# ============================================
# EMAIL PROVIDER
# ============================================

# API key used to send transactional emails.
# The final variable name may change once the provider is selected.
EMAIL_API_KEY=