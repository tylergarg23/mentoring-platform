---
import { Mail } from 'lucide-astro';
---

<footer class="site-footer">
  <div class="footer-top">
    <a href="/" class="footer-logo" aria-label="Ir al inicio">
      <img src="/logo_tyg-footer.svg" alt="Tygar" />
    </a>

    <p>
      Diseño con intención.
      <br />
      Código con carácter.
    </p>

    <div class="socials">
      <a href="#linkedin" aria-label="LinkedIn">
        in
      </a>
      <a href="#instagram" aria-label="Instagram">
        ig
      </a>

      <a href="mailto:hola@tygar.dev" aria-label="Correo electrónico">
        <Mail aria-hidden="true" />
      </a>
    </div>
  </div>

  <div class="footer-bottom">
    <span>© 2026 Tygar. Todos los derechos reservados.</span>
    <span>Hecho con curiosidad + café.</span>
  </div>
</footer>
