---
import { ArrowUpRight } from 'lucide-astro';
---

<section class="mentorship-hero" aria-labelledby="mentorship-title">
  <div class="mentorship-hero-copy">
    <div class="section-kicker">/ MENTORÍA 1:1</div>

    <h1 id="mentorship-title">
      Crece con
      <br />
      <em>intención.</em>
    </h1>

    <p>
      Un espacio para ordenar tus ideas, desbloquear tu potencial y construir una carrera digital
      con más claridad.
    </p>

    <a href="#paquetes" class="button button-yellow">
      Ver mentorías
      <ArrowUpRight aria-hidden="true" />
    </a>
  </div>

  <div class="mentorship-orbit" aria-hidden="true">
    <div class="mentorship-orbit-circle"></div>

    <span class="orbit-item orbit-item-qa">QA</span>
    <span class="orbit-item orbit-item-ui">UI</span>
    <span class="orbit-item orbit-item-go">DEV</span>
  </div>
</section>
