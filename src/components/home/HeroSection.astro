---
import { ArrowUpRight } from 'lucide-astro';
---

<section class="hero-section" aria-labelledby="hero-title">
  <div class="hero-orb hero-orb-one" aria-hidden="true"></div>
  <div class="hero-orb hero-orb-two" aria-hidden="true"></div>

  <div class="hero-copy">
    <p class="eyebrow reveal">
      QA AUTOMATION
      <span>✦</span>
      FRONTEND
      <span>✦</span>
      MENTOR
    </p>

    <h1 id="hero-title" class="hero-title reveal delay-1">
      Diseño experiencias
      <br />
      <em>que se sienten.</em>
    </h1>

    <p class="hero-intro reveal delay-2">
      Soy Tyler, un creador digital que mezcla la precisión de la calidad con la sensibilidad del
      diseño para construir productos que las personas quieren usar.
    </p>

    <div class="hero-actions reveal delay-3">
      <a href="#projects" class="button button-primary">
        Ver mi trabajo
        <ArrowUpRight aria-hidden="true" />
      </a>

      <a href="/contacto" class="button button-ghost">
        Iniciar un proyecto
      </a>
    </div>
  </div>

  <div
    class="hero-visual reveal delay-2"
    aria-label="Composición visual abstracta representando diseño y tecnología"
  >
    <div class="visual-ring ring-one" aria-hidden="true"></div>
    <div class="visual-ring ring-two" aria-hidden="true"></div>

    <div class="visual-card">
      <span>
        diseña
        <br />
        con
        <br />
        <strong>intención</strong>
      </span>

      <div class="card-dot" aria-hidden="true"></div>
    </div>

    <div class="floating-note note-top">01 / 04</div>
    <div class="floating-note note-bottom">hecho con cuidado ↗</div>
  </div>

  <div class="scroll-cue" aria-hidden="true">
    <span class="scroll-line"></span>
    DESLIZA PARA EXPLORAR
  </div>
</section>
