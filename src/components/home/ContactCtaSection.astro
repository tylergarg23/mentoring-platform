---
import { ArrowUpRight } from 'lucide-astro';
---

<section class="contact-cta-section" aria-labelledby="contact-cta-title">
  <div class="contact-cta-container">
    <div class="contact-cta-circle" aria-hidden="true"></div>

    <div class="contact-cta-content">
      <div class="contact-cta-kicker">/ 05 — ¿TRABAJAMOS JUNTOS?</div>

      <h2 id="contact-cta-title">
        Tu próxima gran idea
        <span>merece una forma.</span>
      </h2>

      <p>Cuéntame qué tienes en mente y construyamos algo que la gente recuerde.</p>

      <a href="/contacto" class="contact-cta-button">
        Iniciar un proyecto
        <ArrowUpRight aria-hidden="true" />
      </a>
    </div>
  </div>
</section>
