---
import { ArrowUpRight } from 'lucide-astro';

import { projects } from '../../data/home';
---

<section id="projects" class="projects-section section-shell" aria-labelledby="projects-title">
  <div class="section-kicker">/ 03 — PROYECTOS SELECCIONADOS</div>

  <div class="projects-header">
    <h2 id="projects-title">
      Trabajo que habla
      <br />
      <span>por sí solo.</span>
    </h2>

    <p class="projects-intro">
      Una selección de mis más recientes experiencias donde tecnología, calidad y diseño trabajan
      juntas para resolver problemas reales.
    </p>
  </div>

  <div class="projects-list">
    {projects.map((project) => (
      <article class="project-card">
        <div class:list={['project-visual', project.className]}>
          <span class="project-number" aria-hidden="true">
            {project.number}
          </span>

          <div class="project-image-wrapper">
            <img
              src={project.image}
              alt={project.imageAlt}
              class="project-image"
              loading="lazy"
              decoding="async"
              width="1200"
              height="750"
            />
          </div>
        </div>

        <div class="project-info">
          <p class="project-type">{project.type}</p>

          <h3>{project.title}</h3>

          <p class="project-description">{project.description}</p>

          <ul class="project-tags" aria-label={`Tecnologías de ${project.title}`}>
            {project.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>

          {project.url ? (
            <a
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
              class="project-link-placeholder"
              aria-label={`Ver proyecto ${project.title} (abre en una nueva pestaña)`}
            >
              Ver proyecto
              <ArrowUpRight aria-hidden="true" />
            </a>
          ) : null}
        </div>
      </article>
    ))}
  </div>
</section>
